# --- Application ---
APP_NAME=MediExplain AI
ENVIRONMENT=development
DEBUG=true

# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database ---
# Development (SQLite). For PostgreSQL use:
# postgresql+psycopg://user:password@localhost:5432/mediexplain
DATABASE_URL=sqlite:///./mediexplain.db

# --- Uploads ---
UPLOAD_DIR=../data/uploads
PROCESSED_DIR=../data/processed
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=25
ALLOWED_EXTENSIONS=.pdf,.jpg,.jpeg,.png

# --- OCR ---
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=
OCR_DPI=300

# --- AI provider ---
# ollama | openrouter | cloud | none
AI_PROVIDER=ollama
AI_TIMEOUT_SECONDS=120

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# OpenRouter (https://openrouter.ai/keys)
# Set AI_PROVIDER=openrouter and paste a key to use hosted models.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto
# Example free model: nvidia/nemotron-3-ultra-550b-a55b:free
# Optional attribution header shown in the OpenRouter dashboard.
OPENROUTER_SITE_URL=http://localhost:5173

# Other OpenAI-compatible hosted provider (optional)
CLOUD_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
CLOUD_LLM_API_KEY=
CLOUD_LLM_MODEL=gemini-2.0-flash

# --- CORS ---
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
